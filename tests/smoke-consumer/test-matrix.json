{
  "_doc": "Harness smoke test. smoke-* scenarios must pass; canary-* scenarios must FAIL -- run-smoke.sh asserts both, so a harness that stops reporting failures turns CI red. Images are tar archives mounted through WinFsp's memfs (see fs-windows-test-harness.toml).",
  "scenarios": {
    "smoke-rw-roundtrip": {
      "status": "pending",
      "_doc": "Host creates an image, ships it to the VM; every VM step remounts it and runs one built-in op (list, read with content/size/sha256 checks, mkdir, write, rename, unlink, rmdir); the image is shipped back and the host verifiers read the result out of it, the last with a double-quoted, space-padded argument that must reach the verifier unchanged. Each change is only visible to a later step if it survived an unmount, so the final listings prove the whole chain.",
      "image": "smoke-rw.tar",
      "recipe": [
        { "op": "image-create", "path": "/hello.txt", "content": "hello-from-the-host" },
        { "op": "ship-to-vm", "src": "images/{run_id}/{scenario.image}", "dest": "{vm.workdir}/{scenario.image}" },
        { "op": "win-ls-via-mount", "drive": "X", "path": "/", "expect_names_csv": ".,..,hello.txt", "expect_count": "3" },
        { "op": "win-cat-via-mount", "drive": "X", "path": "/hello.txt", "expect_content": "hello-from-the-host", "expect_size": "19", "expect_sha256": "4b446221383191e3c60c8c7de9fe13ffd1e7fd9bb2dcac11b3322b0ff1f17da6" },
        { "op": "win-mkdir", "drive": "X", "path": "/docs" },
        { "op": "win-write", "drive": "X", "path": "/docs/draft.txt", "content": "first draft" },
        { "op": "win-rename", "drive": "X", "from": "/docs/draft.txt", "to": "/docs/final.txt" },
        { "op": "win-write", "drive": "X", "path": "/scratch.txt", "content": "temporary" },
        { "op": "win-unlink", "drive": "X", "path": "/scratch.txt" },
        { "op": "win-mkdir", "drive": "X", "path": "/empty" },
        { "op": "win-rmdir", "drive": "X", "path": "/empty" },
        { "op": "win-cat-via-mount", "drive": "X", "path": "/docs/final.txt", "expect_content": "first draft", "expect_size": "11", "expect_sha256": "b500263e8e0ccbe3979fa5b5d093ace4bfcb7c55fbd5d50cfd6d32726830efaf" },
        { "op": "win-ls-via-mount", "drive": "X", "path": "/", "expect_names_csv": ".,..,docs,hello.txt", "expect_count": "4" },
        { "op": "ship-to-host", "src": "{vm.workdir}/{scenario.image}", "dest": "images/{run_id}/{scenario.image}" },
        { "op": "host-verify-ls", "path": ".", "expect": "--expect-name docs --expect-name hello.txt --expect-count 2" },
        { "op": "host-verify-ls", "path": "docs", "expect": "--expect-name final.txt --expect-count 1" },
        { "op": "host-verify-cat", "path": "docs/final.txt", "expect": "--expect-size 11 --expect-sha256 b500263e8e0ccbe3979fa5b5d093ace4bfcb7c55fbd5d50cfd6d32726830efaf" },
        { "op": "host-verify-info", "expect": "--expect-stdout-contains 'label:          \"smoke-rw\"' --expect-stdout-contains 'files:          2'" }
      ]
    },
    "canary-wrong-content": {
      "status": "pending",
      "_doc": "EXPECTED TO FAIL. Reads back a file with the wrong expected content. run-smoke.sh asserts the harness reports it failed at the read step with a content mismatch; if this ever passes, the harness has stopped detecting failures.",
      "image": "canary.tar",
      "recipe": [
        { "op": "image-create", "path": "/hello.txt", "content": "hello-from-the-host" },
        { "op": "ship-to-vm", "src": "images/{run_id}/{scenario.image}", "dest": "{vm.workdir}/{scenario.image}" },
        { "op": "win-cat-via-mount", "drive": "Y", "path": "/hello.txt", "expect_content": "not what the host wrote", "expect_size": "__none__", "expect_sha256": "__none__" }
      ]
    }
  }
}
